{
  "name": "code-editor",
  "version": "1.0.0",
  "description": "Premium Code Editor built with Electron, React, TypeScript, and Monaco Editor",
  "main": "out/main/index.js",
  "author": "Aryan Suthar",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "env -u ELECTRON_RUN_AS_NODE electron-vite build",
    "start": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "package": "env -u ELECTRON_RUN_AS_NODE electron-vite build && electron-builder",
    "rebuild": "npx @electron/rebuild -f -w node-pty",
    "postinstall": "npx @electron/rebuild -f -w node-pty || true"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "electron-store": "^8.1.0",
    "monaco-editor": "^0.44.0",
    "node-pty": "^1.0.0",
    "simple-git": "^3.21.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.0",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^2.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-monaco-editor": "^1.1.0"
  }
}
